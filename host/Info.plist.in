<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>@RECOMP_GAME_NAME@</string>
    <key>CFBundleDisplayName</key>
    <string>@RECOMP_GAME_NAME@</string>
    <key>CFBundleIdentifier</key>
    <string>@RECOMP_BUNDLE_ID@</string>
    <key>CFBundleExecutable</key>
    <string>@RECOMP_APP_NAME@</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleSignature</key>
    <string>@RECOMP_BUNDLE_SIGNATURE@</string>
    <key>CFBundleShortVersionString</key>
    <string>@RECOMP_VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@RECOMP_BUILD_NUMBER@</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>@RECOMP_DEVELOPMENT_REGION@</string>
    <key>LSMinimumSystemVersion</key>
    <string>@RECOMP_MINIMUM_MACOS@</string>
    <key>LSApplicationCategoryType</key>
    <string>@RECOMP_APP_CATEGORY@</string>
    <key>LSArchitecturePriority</key>
    <array>
        <string>arm64</string>
    </array>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>@RECOMP_COPYRIGHT@</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
</dict>
</plist>
